# --- Server (required, local dev: pnpm --filter @quire/server dev) ---
DATABASE_URL=postgres://quire:quire@localhost:5432/quire
QUIRE_API_KEY=replace-with-32-byte-hex
UNLOCK_SECRET=replace-with-32-byte-hex
PORT=8787
# WEB_DIST is optional; defaults to <repo>/web/dist.
# TRUST_PROXY defaults to false: the server rate-limits on the socket address.
# Set TRUST_PROXY=true ONLY if a fronting proxy OVERWRITES (not appends)
# X-Forwarded-For, so the real client IP is used for rate limiting.
# TRUST_PROXY=false

# --- Canary (Task 14): v2 write gate + v1 read retirement ---
# v2 writes are OFF by default during the canary window (POST /api/v2/shares
# returns 404 while off). Flip to true once v2 is verified. Never disables
# v2 reads.
# QUIRE_V2_WRITE_ENABLED=false
# v1 public reads are ON by default. Flip to false immediately once v2 is
# verified (no grace window) to retire v1 links. v1 owner reads and the v1
# table are untouched.
# QUIRE_V1_READS_ENABLED=true

# --- Docker (docker compose) ---
# Password for the compose-managed Postgres container:
POSTGRES_PASSWORD=replace-with-a-strong-password
