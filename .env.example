# --- Server (required, local dev: pnpm --filter @quire/server dev) ---
DATABASE_URL=postgres://quire:quire@localhost:5432/quire
QUIRE_API_KEY=replace-with-32-byte-hex
UNLOCK_SECRET=replace-with-32-byte-hex
PORT=8787
# WEB_DIST is optional; defaults to <repo>/web/dist.

# --- Docker (docker compose) ---
# Password for the compose-managed Postgres container:
POSTGRES_PASSWORD=replace-with-a-strong-password
